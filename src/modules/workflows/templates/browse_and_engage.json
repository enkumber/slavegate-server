{
  "id": "browse_and_engage",
  "name": "Browse and Engage",
  "platform": "*",
  "description": "Wake device, unlock, open app, scroll feed, occasionally engage (like) with content. Platform-agnostic — target selectors resolved by platform parser.",
  "version": "1.1.0",
  "defaultVerificationStrategy": "local_with_screenshot",
  "dataRetentionDays": 90,
  "steps": [
    {
      "type": "action",
      "id": "wake_screen",
      "action": "screen_wake",
      "params": {},
      "verification": "local_only",
      "retries": 1,
      "timeoutMs": 5000
    },
    {
      "type": "wait",
      "id": "wait_screen_on",
      "duration": {
        "min": 500,
        "max": 1000,
        "distribution": "uniform"
      }
    },
    {
      "type": "action",
      "id": "unlock_device",
      "action": "unlock",
      "params": {},
      "verification": "local_only",
      "retries": 2,
      "timeoutMs": 10000
    },
    {
      "type": "wait",
      "id": "wait_unlock",
      "duration": {
        "min": 500,
        "max": 1500,
        "distribution": "uniform"
      }
    },
    {
      "type": "action",
      "id": "open_app",
      "action": "open_app",
      "params": {},
      "verification": "local_only",
      "retries": 2,
      "timeoutMs": 15000,
      "expectedScreen": "HOME_FEED",
      "screenConfidenceThreshold": 0.70,
      "screenMismatchPolicy": {
        "maxRetries": 2,
        "delayMs": 1000,
        "action": "retry_step"
      }
    },
    {
      "type": "wait",
      "id": "wait_feed_load",
      "condition": "ui_element_visible",
      "element": "feed_tab",
      "timeoutMs": 10000
    },
    {
      "type": "loop",
      "id": "scroll_loop",
      "count": { "min": 3, "max": 8, "distribution": "uniform" },
      "steps": [
        {
          "type": "action",
          "id": "scroll_feed",
          "action": "scroll",
          "params": {
            "direction": "down",
            "distancePx": 600
          },
          "verification": "local_only"
        },
        {
          "type": "wait",
          "id": "read_pause",
          "duration": {
            "min": 2000,
            "max": 8000,
            "distribution": "lognormal",
            "mean": 4000
          }
        },
        {
          "type": "condition",
          "id": "maybe_like",
          "check": "random_probability",
          "probability": 0.4,
          "if_true": [
            {
              "type": "action",
              "id": "tap_like",
              "action": "tap",
              "target": "post.like",
              "verification": "local_with_screenshot",
              "retries": 1,
              "expectedScreen": ["HOME_FEED", "POST_DETAIL"],
              "screenConfidenceThreshold": 0.70,
              "screenMismatchPolicy": {
                "maxRetries": 1,
                "delayMs": 500,
                "action": "continue_with_warning"
              }
            },
            {
              "type": "wait",
              "id": "post_like_pause",
              "duration": {
                "min": 500,
                "max": 1500,
                "distribution": "normal",
                "mean": 900
              }
            }
          ]
        },
        {
          "type": "condition",
          "id": "maybe_explore",
          "check": "mood_explorer",
          "if_true": [
            {
              "type": "action",
              "id": "tap_profile",
              "action": "tap",
              "target": "post.author_avatar",
              "verification": "local_only",
              "retries": 1,
              "expectedScreen": "PROFILE_OTHER",
              "screenConfidenceThreshold": 0.72,
              "screenMismatchPolicy": {
                "maxRetries": 2,
                "delayMs": 800,
                "action": "retry_step"
              }
            },
            {
              "type": "wait",
              "id": "profile_view_time",
              "duration": {
                "min": 3000,
                "max": 10000,
                "distribution": "lognormal",
                "mean": 5000
              }
            },
            {
              "type": "action",
              "id": "back_to_feed",
              "action": "tap",
              "target": "nav.back",
              "verification": "local_only",
              "expectedScreen": "HOME_FEED",
              "screenConfidenceThreshold": 0.70,
              "screenMismatchPolicy": {
                "maxRetries": 1,
                "delayMs": 500,
                "action": "continue_with_warning"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "checkpoint",
      "id": "pre_close_checkpoint"
    },
    {
      "type": "action",
      "id": "close_app",
      "action": "close_app",
      "params": {},
      "verification": "local_only"
    }
  ]
}
