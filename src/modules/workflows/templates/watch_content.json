{
  "id": "watch_content",
  "name": "Watch Content",
  "platform": "*",
  "description": "Open app, navigate to video/reels/shorts section, watch multiple videos with realistic viewing behavior. Platform-agnostic.",
  "version": "1.0.0",
  "defaultVerificationStrategy": "local_only",
  "dataRetentionDays": 90,
  "steps": [
    {
      "type": "action",
      "id": "open_app",
      "action": "open_app",
      "params": {},
      "verification": "local_only",
      "retries": 2,
      "timeoutMs": 15000
    },
    {
      "type": "wait",
      "id": "wait_app_ready",
      "condition": "app_launched",
      "timeoutMs": 8000
    },
    {
      "type": "action",
      "id": "tap_video_tab",
      "action": "tap",
      "target": "video_tab",
      "verification": "local_with_screenshot",
      "retries": 2
    },
    {
      "type": "wait",
      "id": "wait_feed",
      "condition": "ui_element_visible",
      "element": "video_player",
      "timeoutMs": 8000
    },
    {
      "type": "loop",
      "id": "watch_loop",
      "count": { "min": 2, "max": 6, "distribution": "uniform" },
      "steps": [
        {
          "type": "wait",
          "id": "watch_duration",
          "duration": {
            "min": 5000,
            "max": 45000,
            "distribution": "lognormal",
            "mean": 18000
          }
        },
        {
          "type": "condition",
          "id": "maybe_like_video",
          "check": "random_probability",
          "probability": 0.25,
          "if_true": [
            {
              "type": "action",
              "id": "like_video",
              "action": "tap",
              "target": "like_button",
              "verification": "local_with_screenshot",
              "retries": 1
            }
          ]
        },
        {
          "type": "condition",
          "id": "maybe_pause",
          "check": "random_probability",
          "probability": 0.15,
          "if_true": [
            {
              "type": "action",
              "id": "pause_video",
              "action": "tap",
              "target": "video_player_center",
              "verification": "local_only"
            },
            {
              "type": "wait",
              "id": "paused_duration",
              "duration": {
                "min": 2000,
                "max": 8000,
                "distribution": "normal",
                "mean": 4000
              }
            },
            {
              "type": "action",
              "id": "resume_video",
              "action": "tap",
              "target": "video_player_center",
              "verification": "local_only"
            }
          ]
        },
        {
          "type": "action",
          "id": "swipe_next",
          "action": "swipe",
          "params": {
            "startX": 540,
            "startY": 1400,
            "endX": 540,
            "endY": 400,
            "durationMs": 350
          },
          "verification": "local_only"
        }
      ]
    },
    {
      "type": "checkpoint",
      "id": "pre_close_checkpoint"
    },
    {
      "type": "action",
      "id": "close_app",
      "action": "close_app",
      "params": {},
      "verification": "local_only"
    }
  ]
}
