    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "image-size": "^2.0.2",
    "ioredis": "^5.3.0",
    "multer": "^2.1.1",
    "pg": "^8.11.0",
    "prom-client": "^15.1.0",
    "uuid": "^9.0.0",
    "ws": "^8.14.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.0",
    "eslint": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
